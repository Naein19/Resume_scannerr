# Copy to .env and fill in real values. Never commit the real .env file.

# Google AI Studio (Gemini) API key — free tier, no billing required.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key-here

# Optional sibling keys (each from a separate Google account/project, so
# each has its own independent free-tier quota). If set, the pipeline
# rotates to the next one when the current key hits a 429. All optional —
# omit any you don't have.
# GOOGLE_API_KEY1=
# GOOGLE_API_KEY2=
# GOOGLE_API_KEY3=

# Model ids — check aistudio.google.com's model picker for the current
# newest free Flash model before deploying.
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash
GEMINI_SCORING_MODEL=gemini-2.5-flash

# MongoDB connection string (Atlas: mongodb+srv://user:pass@cluster.../ ,
# or mongodb://localhost:27017 for a local instance). No ORM, no
# migrations — collections/indexes are ensured idempotently at startup.
MONGO_URL=mongodb+srv://user:password@your-cluster.mongodb.net/?appName=your-app
DB_NAME=Resume_Scanner

# Embedding pre-filter
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_SIMILARITY_THRESHOLD=0.35

# Uploads (resume files live in the resume_pdfs GridFS bucket, not local disk)
MAX_UPLOAD_SIZE_BYTES=5242880

# Rate limiting
RATE_LIMIT_PER_MINUTE=20

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
